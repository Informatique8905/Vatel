# ---- Serveur ----
PORT=4000
NODE_ENV=development
# URL du frontend autorisée en CORS (allowlist, spec §12.3)
CORS_ORIGIN=http://localhost:5173

# ---- Base de données (docker compose local) ----
DATABASE_URL=postgresql://vatel:vatel@localhost:5433/vatel?schema=public

# ---- Auth (spec §12) ----
# Secrets de démo uniquement — jamais de vrais secrets dans Git
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Connexion Google (spec §12.1) : renseigner le Client ID OAuth pour activer /api/auth/google
GOOGLE_CLIENT_ID=

# ---- Agrégateur de paiement : Jeko (spec §8.2) ----
# À remplir avec la documentation officielle Jeko — endpoints et clés réels
PAYMENT_PROVIDER=jeko
JEKO_API_BASE_URL=
JEKO_API_KEY=
JEKO_API_KEY_ID=
JEKO_STORE_ID=
PAYMENT_SUCCESS_URL=http://localhost:5173/parent/recharge/succes
PAYMENT_ERROR_URL=http://localhost:5173/parent/recharge/erreur
TOPUP_EXPIRES_MINUTES=30
JEKO_WEBHOOK_SECRET=

# ---- Règles métier À CONFIRMER (spec §19) ----
# Valeurs provisoires isolées ici en attendant les décisions de l'équipe
RESERVATION_CUTOFF_MINUTES=120      # heure limite de réservation avant le service
CANCELLATION_CUTOFF_MINUTES=60      # délai d'annulation autorisé
LOW_BALANCE_THRESHOLD_XOF=500       # seuil d'alerte solde faible
NOT_COLLECTED_REFUND=false          # politique repas non récupéré : débit conservé

# ---- E-mails (codes OTP) : Resend ----
# Clé API Resend — jamais en dur dans le code (https://resend.com/api-keys)
RESEND_API_KEY=
# Expéditeur affiché (domaine vérifié Resend, sinon onboarding@resend.dev en test)
EMAIL_FROM=Cantine Vatel <onboarding@resend.dev>
# Durée de vie du code OTP en minutes / tentatives max / délai entre renvois
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=60

# Admin initial (creation au demarrage, jamais via inscription)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Cloudinary (images des plats)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_MAX_BYTES=5242880

# ---- Notifications push (Web Push / VAPID) ----
# Generer : npx web-push generate-vapid-keys ; la cle privee reste serveur.
# Vides en dev -> push ignore, notifications conservees en historique.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com
# Firebase Cloud Messaging : JSON du compte de service (Admin SDK) encodé en base64
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Rappels de creneau + worker
REMINDER_BEFORE_START_MINUTES=5
REMINDER_BEFORE_END_MINUTES=5
REMINDER_POLL_MS=30000
REMINDER_MAX_ATTEMPTS=3

# Liaisons parent-enfant
LINK_INVITATION_TTL_HOURS=72
